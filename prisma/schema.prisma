generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Monitor {
  id              String         @id @default(uuid())
  url             String
  name            String
  intervalMins    Int
  sensitivity     Int            @default(5)
  ignoreSelectors String?
  watchSelectors  String?
  lastCheckedAt   DateTime?
  lastChangedAt   DateTime?
  nextCheckAt     DateTime?
  status          String         @default("OK")
  ownerId         String?
  owner           ApiKey?        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  snapshots       Snapshot[]
  alerts          Alert[]

  @@index([nextCheckAt])
  @@index([ownerId])
  @@index([url])
}

model ApiKey {
  id        String    @id @default(uuid())
  name      String
  keyHash   String    @unique
  isAdmin   Boolean   @default(false)
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  monitors  Monitor[]
}

model Snapshot {
  id          String   @id @default(uuid())
  monitorId   String
  monitor     Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  contentHash String
  textContent String
  imagePath   String
  diffPath    String?
  createdAt   DateTime @default(now())

  @@index([monitorId, createdAt])
}

model Alert {
  id        String   @id @default(uuid())
  monitorId String
  monitor   Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  summary   String
  kind      String   @default("change")
  dedupeKey String?
  sentAt    DateTime @default(now())

  @@unique([monitorId, dedupeKey])
  @@index([monitorId, sentAt])
}
